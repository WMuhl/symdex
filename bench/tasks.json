{
  "rules": {
    "warmRuns": 5,
    "limit": 50,
    "grepK": 5,
    "spanCapLines": 12,
    "maxSpans": 20,
    "tokenDivisor": 4,
    "output": "json"
  },
  "scoring": "Expected locations are the answer to the natural-language question (file:line, repo-relative, forward slashes), not the rows a tool's matcher is specified to emit. Symdex predictions are the unique file:startLine (find/outline) or file:line (refs/callers) values in the JSON it prints at --limit 50. Identical spans are read once. The first 20 distinct spans are read, each capped at 12 lines, overlapping spans in a file are merged for byte counts, and tool calls are 1 plus the merged span count. Grep predictions are the unique file:line hits from `git grep -n -I -F -- <term>` over the whole clone. The baseline then reads, in full, every distinct file among the first 5 hits. Outline questions use a full-file read instead of grep: recall is how many expected lines sit in that file, and precision is null because the read does not extract locations. Tokens are bytes/4. A symdex: stderr line on the C# cold run means Roslyn fell back, except a line that only reports an auto-discovered solution (`symdex: using '...'`). The humanizer-autosln block is supplementary and is not included in the 22-question overall.",
  "targets": [
    {
      "id": "humanizer",
      "language": "csharp",
      "url": "https://github.com/Humanizr/Humanizer.git",
