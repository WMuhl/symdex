      "supplementary": {
        "id": "humanizer-autosln",
        "label": "Same Humanizer commit and questions, no --solution. Prep is dotnet restore src/Humanizer.slnx. Symdex auto-discovers that solution, which includes test projects. Not part of the 22-question overall.",
        "prep": [
          { "file": "dotnet", "args": ["restore", "src/Humanizer.slnx"] }
        ]
      },
