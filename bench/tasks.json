      "unshallow": true,
      "unshallowReason": "A depth-1 clone makes MSBuildWorkspace fail: Nerdbank.GitVersioning cannot compute version height, Roslyn aborts, and symdex falls back to tree-sitter. The harness unshallows before restore.",
