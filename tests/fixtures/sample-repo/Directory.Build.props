<Project>
  <!-- Isolates this fixture from the outer symdex repo's Directory.Build.props (which sets
       TreatWarningsAsErrors, etc.) - it's a target codebase for tests, not part of symdex itself. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
